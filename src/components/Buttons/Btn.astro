---
const { url, text } = Astro.props;
---

<a class="btn" target="_blank" rel="noopener" href={url}>{text}</a>

<style>
    .btn {
        background-color: #4CAF50;
        border: none;
        color: white;
        padding: 15px 32px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 16px;
    }
</style>
