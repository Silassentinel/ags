---
/*
 * AsciiBackground: one animated ascii.rest piece as a full-viewport backdrop
 * behind the page content.
 *
 *   ---
 *   import AsciiBackground from "../components/Background/AsciiBackground.astro";
 *   ---
 *   <AsciiBackground piece="matrix-rain" fps={12} />
 *
 * Why this component instead of `import Ascii from "ascii.rest/astro"`:
 *   - the library's <Ascii> / <ascii-art> tag fetches a fallback font from
 *     https://ascii.rest at runtime (third-party request on every visit) and
 *     injects a <style> element from script, which this site's CSP
 *     (security.csp: true, no 'unsafe-inline') rejects;
 *   - it renders an inline style="" attribute for canvas pieces, which the
 *     same CSP blocks;
 *   - a backdrop needs "cover" sizing, which the library tag does not do.
 * So this uses the library's lower-level `mount()` API, like ascii.rest's own
 * site does, and keeps every style in a stylesheet or on the CSSOM.
 *
 * The first frame is rendered at build time (text pieces), so the page is
 * whole before any script runs. Pieces hold that frame when the reader
 * prefers reduced motion (mount() handles this) and pause while the tab is
 * hidden. The piece name is validated at build time: a wrong name fails the
 * build, never the page.
 */
import { canvas as canvasPieces, isPiece, load, type Piece, type PieceName } from "ascii.rest";

interface Props {
  /** A piece's file name, e.g. "matrix-rain", "starfield", "night-coast". */
  piece: PieceName;
  /** Overrides the piece's own frame rate. Lower is cheaper on the CPU. */
  fps?: number;
}

const { piece, fps } = Astro.props;
if (!isPiece(piece)) throw new Error(`AsciiBackground: there is no piece named "${piece}"`);
// Typed as the generic piece contract: load[] returns the union of all 191 module types otherwise.
const mod: Piece = await load[piece]();
const { meta } = mod;
const onCanvas = canvasPieces.has(piece);
// Text pieces get a server-rendered first frame; coloured pieces draw on a canvas once the script runs.
const still = onCanvas ? "" : mod.default(meta.options ?? {})(0, { paper: true });
---

<div class="ascii-bg" aria-hidden="true">
  <pre class="ascii-bg__piece" data-piece={piece} data-fps={fps} data-cols={meta.cols} data-rows={meta.rows} data-cell={meta.cell ?? 2}>{still}</pre>
</div>

<script>
  import { isPiece, load, mount, type Piece } from "ascii.rest";

  // Monospace glyphs are about 0.6em wide and rows are 1.2em tall (see the stylesheet below).
  const GLYPH_W = 0.6;
  const LINE_H = 1.2;

  function start(pre: HTMLPreElement) {
    const name = pre.dataset.piece ?? "";
    if (!isPiece(name)) return;
    const wrap = pre.parentElement as HTMLElement;
    const fps = Number(pre.dataset.fps) || undefined;

    load[name]().then((piece: Piece) => {
      const { cols, rows, cell = 2, palette } = piece.meta;
      let el: HTMLElement = pre;

      if (palette) {
        // A coloured piece draws on a canvas as wide as its box; mount() keeps the aspect ratio.
        el = document.createElement("canvas");
        el.className = "ascii-bg__piece";
        // Astro scopes this component's styles with a data-astro-cid-* attribute; carry it over so the rules apply.
        for (const { name } of Array.from(pre.attributes)) if (name.startsWith("data-astro-cid")) el.setAttribute(name, "");
        pre.replaceWith(el);
      }

      // "Cover" sizing: scale the piece so it fills both viewport axes, overflow clipped by the wrapper.
      // Everything is set through the CSSOM, never an inline style attribute, so the site's CSP allows it.
      const fit = () => {
        const w = wrap.clientWidth;
        const h = wrap.clientHeight;
        if (palette) {
          const ratio = cols / (rows * cell);
          el.style.width = `${Math.max(w, h * ratio)}px`;
        } else {
          const px = Math.max(w / (cols * GLYPH_W), h / (rows * LINE_H));
          el.style.fontSize = `${px}px`;
        }
      };
      fit();
      new ResizeObserver(fit).observe(wrap);

      mount(el, piece, fps ? { fps } : {});
    });
  }

  document.querySelectorAll<HTMLPreElement>(".ascii-bg > pre[data-piece]").forEach(start);
</script>

<style>
  .ascii-bg {
    position: fixed;
    inset: 0;
    z-index: -1; /* behind the body's content, above the html background */
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Faint by default so the page's text stays readable; tune per theme. */
    opacity: 0.18;
    color: #000;
  }

  :global(html.dark) .ascii-bg {
    opacity: 0.28;
    color: #fff;
  }

  .ascii-bg__piece {
    margin: 0;
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: pre;
    font-variant-ligatures: none;
  }

  /* Coloured pieces: mount() sets the width/aspect-ratio on the element itself. */
  .ascii-bg :global(canvas.ascii-bg__piece) {
    display: block;
  }
</style>
