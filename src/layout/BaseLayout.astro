---
import "../styles/global.css";
import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
import ClientScripts from "../components/ui/ClientScripts";
import AsciiBackground from "../components/Background/AsciiBackground.astro";

interface Props {
    pageTitle: string;
    /** BCP 47 language of the page's content; "nl" for the Dutch pages. */
    lang?: string;
}

const { pageTitle, lang = "en" } = Astro.props;
const skipLabel = lang.startsWith("nl") ? "Naar de inhoud" : "Skip to content";
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <!-- First focusable element on every page: lets keyboard and screen-reader users jump past the navigation -->
        <a class="skip-link" href="#main">{skipLabel}</a>
        <!-- Seasonal animated ascii backdrop, behind everything (docs/features/ascii-background/) -->
        <AsciiBackground />
        <Header />
        <!-- tabindex="-1" so the skip link can move focus here in every browser -->
        <main id="main" tabindex="-1">
            <h1 class="brutalist-title">{pageTitle}</h1>
            <slot />
        </main>
        <Footer />
        
        <!-- Client-side scripts as Preact components (client-only rendering) -->
        <ClientScripts client:only="preact" />
    </body>
</html>

<style>
    .brutalist-title {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-family: monospace;
        border-bottom: 3px solid #000;
    }
    
    :global(.dark) .brutalist-title {
        border-color: #fff;
    }
</style>
