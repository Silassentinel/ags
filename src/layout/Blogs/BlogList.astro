---
// Define the type for the frontmatter
interface Frontmatter {
  title: string;
  author: string;
  pubDate: string;
  // Add other frontmatter properties as needed
}

// Define the type for the post
interface Post {
  frontmatter: Frontmatter;
  url?: string;
  // Add other post properties as needed
}

const posts = await Promise.all(
  Object.entries(import.meta.glob<{ frontmatter: Frontmatter; url?: string }>("../../pages/posts/*.md"))
    .map(([_, resolver]) => resolver())
);
const allPosts = posts as Post[];

---

{
    allPosts &&
    allPosts.map((post) => (
        <li class="post">
            <a href={post.url}>{post.frontmatter.title}</a>
            <span class="post-meta">
                by {post.frontmatter.author},{" "}
                <time datetime={new Date(post.frontmatter.pubDate).toISOString().slice(0, 10)}>
                    {new Date(post.frontmatter.pubDate).toLocaleDateString('nl-BE')}
                </time>
            </span>
        </li>
    ))
}

<style>
    .post {
        padding: 0.5rem 0;
        border-bottom: 1px solid currentColor;
    }

    .post-meta {
        display: block;
        font-weight: normal;
        font-size: 0.9em;
    }
</style>
