---
import BaseLayout from "../layout/BaseLayout.astro";
const pageTitle = "Seizoenskalender";

import { SEASON_MONTHS as months, linkedTagForProduce } from "../scripts/ContentBuilder/Season/seasonCalendar";
import { filterValidTags } from "../scripts/ContentBuilder/Tags/tagUtils";

// Every tag used by at least one recipe, filtered with the same allow-list
// src/pages/tags/[tag].astro uses to decide which /tags/<tag> pages exist,
// so a calendar entry only ever links to a page that was actually built.
const posts = await Promise.all(
  Object.values(import.meta.glob<{ frontmatter: { tags?: string[] } }>("./posts/*.md")).map(resolve => resolve())
);
const recipeTags = new Set(filterValidTags(posts.flatMap(post => post.frontmatter.tags ?? [])));

const now = new Date();
const currentMonth = now.getMonth();
---

<BaseLayout pageTitle={pageTitle}>
  <section class="cal-intro">
    <p>Seizoensgroenten & fruit voor <strong>Belgi&euml;</strong> — volle grond / onverwarmde serres.</p>
    <p class="legend"><span class="tag tag-groente has-recipes">vet</span> = er zijn recepten mee — klik om ze te zien.</p>
    <nav class="month-nav">
      {months.map((m, i) => (
        <a href={`#${m.name.toLowerCase()}`} class:list={["month-link", { active: i === currentMonth }]}>
          {m.name.substring(0, 3)}
        </a>
      ))}
    </nav>
  </section>

  {months.map((month, i) => (
    <section id={month.name.toLowerCase()} class:list={["month-card", { "current-month": i === currentMonth }]}>
      <h2 class="month-title">
        {month.name}
        {i === currentMonth && <span class="now-badge">nu</span>}
      </h2>

      <div class="produce-section">
        <h3 class="produce-label">Groenten <span class="count">{month.groenten.length}</span></h3>
        <div class="tag-cloud">
          {month.groenten.map(g => {
            const tag = linkedTagForProduce(g, recipeTags);
            return tag
              ? <a href={`/tags/${tag}`} class="tag tag-groente has-recipes" title={`Recepten met ${tag}`}>{g}</a>
              : <span class="tag tag-groente">{g}</span>;
          })}
        </div>
      </div>

      <div class="produce-section">
        <h3 class="produce-label">Fruit <span class="count">{month.fruit.length}</span></h3>
        <div class="tag-cloud">
          {month.fruit.map(f => {
            const tag = linkedTagForProduce(f, recipeTags);
            return tag
              ? <a href={`/tags/${tag}`} class="tag tag-fruit has-recipes" title={`Recepten met ${tag}`}>{f}</a>
              : <span class="tag tag-fruit">{f}</span>;
          })}
        </div>
      </div>
    </section>
  ))}

  <footer class="cal-sources">
    <h3>Bronnen</h3>
    <ul>
      <li>Velt vzw seizoenskalender (groentekalender.be)</li>
      <li>mijnspar.be seizoensgroenten</li>
      <li>Lekker van bij ons (VLAM)</li>
    </ul>
  </footer>
</BaseLayout>

<style>
  .cal-intro {
    margin-bottom: 2rem;
    font-family: monospace;
  }

  .month-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 1rem;
  }

  .month-link {
    padding: 4px 8px;
    border: 1px solid #000;
    text-decoration: none;
    font-family: monospace;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .month-link:hover {
    color: #fff;
    background-color: #000;
  }

  .month-link.active {
    color: #fff;
    background-color: #000;
    border-color: #000;
    font-weight: bold;
  }

  :global(.dark) .month-link {
    border-color: #fff;
    color: #fff;
  }

  :global(.dark) .month-link:hover {
    color: #000;
    background-color: #fff;
  }

  :global(.dark) .month-link.active {
    color: #000;
    background-color: #fff;
    border-color: #fff;
  }

  .month-card {
    border: 2px solid #000;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .month-card.current-month {
    border-width: 3px;
    box-shadow: 4px 4px 0 #000;
  }

  :global(.dark) .month-card {
    border-color: #fff;
  }

  :global(.dark) .month-card.current-month {
    box-shadow: 4px 4px 0 #fff;
  }

  .month-title {
    font-family: monospace;
    font-size: 1.5rem;
    text-transform: uppercase;
    margin: 0 0 1rem;
    border-bottom: 2px solid #000;
    padding-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.dark) .month-title {
    border-color: #fff;
  }

  .now-badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border: 2px solid #000;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 1px;
  }

  :global(.dark) .now-badge {
    border-color: #fff;
  }

  .produce-section {
    margin-bottom: 1rem;
  }

  .produce-label {
    font-family: monospace;
    font-size: 0.9rem;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .count {
    font-size: 0.75rem;
    border: 1px solid #888;
    padding: 0 5px;
    color: #888;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-family: monospace;
    font-size: 0.8rem;
    padding: 2px 8px;
    border: 1px solid;
    display: inline-block;
  }

  a.tag {
    text-decoration: none;
  }

  .has-recipes {
    font-weight: bold;
    border-width: 2px;
  }

  .legend {
    font-size: 0.85rem;
  }

  .tag-groente {
    border-color: #2d6a2e;
    color: #2d6a2e;
  }

  .tag-groente:hover {
    background-color: #2d6a2e;
    color: #fff;
  }

  .tag-fruit {
    border-color: #8b2252;
    color: #8b2252;
  }

  .tag-fruit:hover {
    background-color: #8b2252;
    color: #fff;
  }

  :global(.dark) .tag-groente {
    border-color: #5cb85c;
    color: #5cb85c;
  }

  :global(.dark) .tag-groente:hover {
    background-color: #5cb85c;
    color: #000;
  }

  :global(.dark) .tag-fruit {
    border-color: #e77;
    color: #e77;
  }

  :global(.dark) .tag-fruit:hover {
    background-color: #e77;
    color: #000;
  }

  .cal-sources {
    border-top: 2px solid #000;
    margin-top: 2rem;
    padding-top: 1rem;
    font-family: monospace;
    font-size: 0.85rem;
  }

  .cal-sources h3 {
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .cal-sources ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .cal-sources li {
    margin-bottom: 0.25rem;
  }

  :global(.dark) .cal-sources {
    border-color: #fff;
  }
</style>
